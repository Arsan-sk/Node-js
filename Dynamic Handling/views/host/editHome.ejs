<%- include('../partials/head') %>

       <body class="min-h-screen bg-gradient-to-b from-red-50 to-gray-50 flex flex-col">
              <%- include('../partials/navbar') %>

                     <h1 class="text-3xl mt-4     font-extrabold text-center tracking-tight drop-shadow-sm">
                            <%= editing ? 'Edit Home' : 'Add Home' %>
                     </h1>
                     <div class="container mx-auto px-5  flex flex-wrap justify-center gap-4">
                            <main class="flex-1 flex items-center justify-center p-8">
                                   <form action="/host/<%= editing ? 'editHome' : 'addHome' %>" method="POST"
                                          class="w-full max-w-md bg-white rounded-2xl shadow-lg p-8 space-y-5 border border-gray-100 transition-transform duration-300 hover:shadow-xl hover:-translate-y-1"
                                          novalidate>
                                          <input type="hidden" name="id" value="<%= editing ? home.id : '' %>">
                                          <input id="title" type="text" name="title" placeholder="Title" required value="<%= editing ? home.title : '' %>"
                                                 class="block w-full border border-gray-300 rounded-lg px-4 py-2.5 text-gray-700 focus:outline-none focus:ring-2 focus:ring-red-300 focus:border-red-400 transition-all duration-200">

                                          <input id="description" type="text" name="description" value="<%= editing ? home.description : '' %>"
                                                 placeholder="Description" required
                                                 class="block w-full border border-gray-300 rounded-lg px-4 py-2.5 text-gray-700 focus:outline-none focus:ring-2 focus:ring-red-300 focus:border-red-400 transition-all duration-200">

                                          <input id="price" type="number" name="price" placeholder="Price Per Night" value="<%= editing ? home.price : '' %>"
                                                 required
                                                 class="block w-full border border-gray-300 rounded-lg px-4 py-2.5 text-gray-700 focus:outline-none focus:ring-2 focus:ring-red-300 focus:border-red-400 transition-all duration-200">

                                          <input id="imgUrl" type="text" name="imageUrl" placeholder="Image URL" value="<%= editing ? home.imageUrl : '' %>"
                                                 required
                                                 class="block w-full border border-gray-300 rounded-lg px-4 py-2.5 text-gray-700 focus:outline-none focus:ring-2 focus:ring-red-300 focus:border-red-400 transition-all duration-200">

                                          <input type="submit" value="<%= editing ? 'Update Home' : 'Add Home' %>"
                                                 class="w-full bg-red-600 text-white font-semibold px-5 py-3 rounded-lg shadow-md hover:bg-red-700 hover:shadow-lg cursor-pointer transition-all duration-300 transform hover:-translate-y-0.5">
                                   </form>
                            </main>

                            
       </body>

       </html>