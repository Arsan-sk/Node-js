<%- include('../partials/head') %>

    <body class="min-h-screen bg-gradient-to-b from-red-50 to-gray-50 flex flex-col">
        <%- include('../partials/navbar') %>
            <h1 class="text-3xl mt-4 font-extrabold text-center tracking-tight drop-shadow-sm">Home Deails Page is Here
            </h1>
            <div class="max-w-4xl mx-auto bg-white rounded-2xl shadow-lg border border-gray-200 overflow-hidden mt-4">
                <!-- Image Section -->
                <div class="relative h-80 w-full overflow-hidden">
                    <% if (home.imageUrl) { %>
                        <img src="<%= home.imageUrl %>" alt="Image of <%= home.title %>"
                            class="w-full h-full object-cover transition-transform duration-300 ease-in-out hover:scale-105">
                        <% } else { %>
                            <div class="w-full h-full bg-gray-100 flex items-center justify-center text-gray-400">
                                <svg xmlns="http://www.w3.org/2000/svg" class="w-20 h-20" fill="none"
                                    viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5"
                                        d="M3 7v10a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V7M8 7V5a4 4 0 0 1 8 0v2" />
                                </svg>
                            </div>
                            <% } %>
                                <div class="absolute top-3 right-3">
                                    <%- include('../partials/fav', { home: home }) %>
                                </div>
                </div>

                <!-- Content Section -->
                <div class="p-8">
                    <div class="flex items-center justify-between mb-4">
                        <h2 class="text-3xl font-bold text-gray-900">
                            <%= home.title %>
                        </h2>
                        <span class="text-2xl font-semibold text-red-600">$<%= home.price %>/night</span>
                    </div>

                    <p class="text-gray-700 leading-relaxed mb-6">
                        <%= home.description %>
                    </p>

                    <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 text-gray-600 mb-6">
                        <div><span class="font-semibold text-gray-800">Location:</span>
                            <%= home.location || 'Not specified' %>
                        </div>
                        <div><span class="font-semibold text-gray-800">Bedrooms:</span>
                            <%= home.bedrooms || 'N/A' %>
                        </div>
                        <div><span class="font-semibold text-gray-800">Bathrooms:</span>
                            <%= home.bathrooms || 'N/A' %>
                        </div>
                        <div><span class="font-semibold text-gray-800">Available:</span>
                            <%= home.available ? 'Yes' : 'No' %>
                        </div>
                    </div>

                    <!-- Buttons -->
                    <div class="flex flex-wrap gap-4 justify-start">
                        <button
                            class="bg-green-600 text-white font-semibold px-6 py-3 rounded-lg shadow-md border border-green-600 hover:bg-green-700 hover:shadow-lg transition-all duration-300 ease-in-out transform hover:-translate-y-0.5">
                            Book Now
                        </button>

                        <a href="/"
                            class="bg-white text-red-600 font-semibold px-6 py-3 rounded-lg shadow-md border border-red-500 hover:bg-red-600 hover:text-white hover:shadow-lg transition-all duration-300 ease-in-out transform hover:-translate-y-0.5">
                            Back to Listings
                        </a>
                    </div>
                </div>
            </div>