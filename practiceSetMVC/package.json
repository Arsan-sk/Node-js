  "type": "commonjs",
  "main": "app.js",
  "scripts": {
    "test": "echo \"Error: no test specified\" && exit 1",
    "build:css": "npx @tailwindcss/cli -i ./views/input.css -o ./public/output.css",
    "watch:css": "npx @tailwindcss/cli -i ./views/input.css -o ./public/output.css --watch",
