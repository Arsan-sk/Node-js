<div class="container mx-auto px-5 mt-5 flex flex-wrap justify-center gap-4">
    <% if (registeredHomes && registeredHomes.length) { %>
        <% registeredHomes.forEach(function(home) { %>
            <div class="max-w-sm bg-white rounded-lg shadow-sm border border-gray-200 overflow-hidden">
                <figure class="overflow-hidden rounded-t-lg">
                    <% if (home.imageUrl) { %>
                        <img src="<%= home.imageUrl %>" alt="Image of <%= home.title %>"
                            class="w-full h-48 object-cover border-b border-gray-200 rounded-lg transition-transform duration-300 ease-in-out hover:scale-105">
                        <% } else { %>
                            <div class="w-full h-48 bg-gray-100 flex items-center justify-center text-gray-400">
                                <svg xmlns="http://www.w3.org/2000/svg" class="w-16 h-16" fill="none"
                                    viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5"
                                        d="M3 7v10a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V7M8 7V5a4 4 0 0 1 8 0v2" />
                                </svg>
                            </div>
                            <% } %>
                </figure>
                <div class="p-4 flex-1 flex flex-col">
                    <h3 class="text-lg font-semibold text-gray-900 truncate">
                        <%= home.title %>
                    </h3>
                    <p class="mt-2 text-sm text-gray-600 flex-1 overflow-hidden">
                        <%= home.description %>
                    </p>
                    <div class="mt-4 flex items-center justify-between mb-0">
                        <span class="text-red-600 font-bold">$<%= home.price %>/night</span>
                    </div>
                    <div>
                        <a href="homeDetails/<%= home.id %>">
                        <button
                            class="mt-4 mb-4 bg-blue-600 text-white font-semibold px-5 py-2 rounded-lg shadow-md border border-blue-600 hover:bg-blue-700 hover:shadow-lg transition-all duration-300 ease-in-out transform hover:-translate-y-0.5 whitespace-nowrap">
                            Details
                        </button>
                    </a>
                        <button
                        class="mt-4 mb-4 bg-green-600 text-white font-semibold px-5 py-2 rounded-lg shadow-md border border-green-600 hover:bg-green-700 hover:shadow-lg transition-all duration-300 ease-in-out transform hover:-translate-y-0.5 whitespace-nowrap">
                        Book
                    </button>
                    </div>
                </div>
            </div>
            <% }) %>
                <% } else { %>
                    <p class="text-gray-600">No homes found.</p>
                    <% } %>
</div>